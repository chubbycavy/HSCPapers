{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HSCPapers",
  "version": "0.9.1",
  "identifier": "app.hscpapes.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:8000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HSCPapers",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://hscpapers.pages.dev; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "Education",
    "shortDescription": "Trial and HSC papers library"
  }
}
